# Cabeceras de Workers Static Assets. Sustituyen a las reglas de caché de nginx.
# La API no pasa por aquí (la sirve el Worker con `Cache-Control: no-store`).

# Todo lo de /assets lleva hash en el nombre: un año e inmutable es correcto.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Los iconos llevan `.vN` a mano en el nombre: mismo trato.
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Las pantallas de arranque también llevan `.vN` en el nombre.
/splash/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker no puede quedarse congelado: quien ya tenga la app
# instalada se quedaría clavado en la versión vieja sin forma de enterarse.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# El shell nombra los assets con hash: si se congela, apunta a ficheros que el
# despliegue siguiente ya ha borrado. Igual el manifest, que no lleva hash.
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
