{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-ride",
  "main": "./worker/index.ts",
  // La fecha la marca el workerd más antiguo del repositorio, el que trae
  // `@cloudflare/vitest-pool-workers`: así las pruebas corren con la misma
  // semántica que `pnpm dev` y que producción. Subirla junto con ese paquete.
  "compatibility_date": "2026-08-15",
  // `node:crypto`/`node:buffer` los piden el SDK de Anthropic y Better Auth.
  "compatibility_flags": ["nodejs_compat"],

  // La SPA y la API salen del mismo origen: sin CORS, y la cookie de sesión es
  // de primera parte, que es la única que una PWA instalada en iOS conserva sin
  // sorpresas. `/api/*` y `/health` pasan siempre por el Worker: en modo SPA,
  // una navegación a una ruta desconocida devolvería `index.html`.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "next-ride",
      "database_id": "d3788b0d-c9ec-4368-930e-390dbd1670dc",
      "migrations_dir": "migrations"
    }
  ],

  // Payloads crudos del scraper (un objeto por lote) y backups diarios.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "next-ride" }],

  // El agente de IA tarda minutos: más que el `waitUntil` de una petición.
  // Cada llamada al modelo es un paso durable y reintentable.
  "workflows": [
    {
      "name": "next-ride-ranking",
      "binding": "RANKING_WORKFLOW",
      "class_name": "RankingWorkflow"
    }
  ],

  // Backup diario de D1 a R2.
  "triggers": { "crons": ["17 3 * * *"] },

  // El único secreto sin el que no se arranca. Declararlo aquí hace que
  // `wrangler types` no dependa de lo que haya en `.dev.vars` (en CI no hay).
  // Los opcionales (ANTHROPIC_API_KEY, FIRST_SUPERUSER_*, BOOTSTRAP_SCRAPER_API_KEY)
  // se tipan en `worker/env.d.ts`.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },

  // Configuración no secreta. Los secretos (BETTER_AUTH_SECRET,
  // ANTHROPIC_API_KEY, FIRST_SUPERUSER_PASSWORD, BOOTSTRAP_SCRAPER_API_KEY…)
  // van con `wrangler secret put` y, en local, en `.dev.vars`.
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOW_REGISTRATION": "false",
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "ANTHROPIC_EFFORT": "high",
    "ANTHROPIC_MAX_TOKENS": "16000",
    "ANTHROPIC_ENABLE_FALLBACKS": "true",
    "RANKING_MAX_ITERATIONS": "10",
    "RANKING_MAX_OFFERS": "40",
    "BACKUP_RETENTION_DAYS": "30"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  "upload_source_maps": true
}
