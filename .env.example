# Copia este fichero a `.env` — docker compose lo lee automáticamente.
# cp .env.example .env

# --- Puertos publicados en el host ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Puerto en el host para inspeccionar la BD. Cámbialo si el 5432 está ocupado.
POSTGRES_HOST_PORT=5433

# --- Base de datos ---
POSTGRES_USER=nextride
POSTGRES_PASSWORD=nextride
POSTGRES_DB=nextride

# En la v1 el esquema se crea al arrancar. Ponlo a false cuando pases a Alembic.
AUTO_CREATE_TABLES=true

# --- Aplicación ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# Genera uno real con: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
ALLOW_REGISTRATION=true

# Usuario administrador creado al arrancar (idempotente).
FIRST_SUPERUSER_EMAIL=admin@next-ride.dev
FIRST_SUPERUSER_PASSWORD=changeme123

# Opcional: API key con la que el scraper puede ingestar desde el minuto cero.
# Formato obligatorio: nr_<prefijo>_<secreto>
# BOOTSTRAP_SCRAPER_API_KEY=nr_dev0001_cambia-este-secreto-largo

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Agente de IA (Anthropic) ---
# Sin esta clave, la app funciona pero el ranking con IA queda desactivado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_ENABLE_FALLBACKS=true
# Máximo de ofertas que se le pasan al agente en un run.
RANKING_MAX_OFFERS=40
